{
  "name": "project-ultron",
  "version": "0.5.0-mark2-unified",
  "private": true,
  "description": "ULTRON Mark 2 local-first personal AI assistant core with integrated Interface1 UI",
  "scripts": {
    "interface:runtime": "node scripts/ensure-interface-runtime.mjs",
    "interface:sync": "npm run interface:runtime && node scripts/sync-interface.mjs",
    "interface:build": "npm run interface:sync && vite build --config interface/vite.config.ts",
    "interface:check": "npm run interface:sync && tsc --noEmit -p interface/tsconfig.json",
    "core:start": "npm run interface:build && node --env-file=.env core/server.js",
    "core:voice": "node --env-file=.env core/voice/daemon.js",
    "core:voice-clone": "node --env-file=.env scripts/setup-voice-clone.mjs",
    "core:check": "node --env-file=.env core/smoke-test.js",
    "core:stream-check": "node --env-file=.env core/stream-smoke-test.js",
    "core:memory-test": "node --env-file=.env core/memory-smoke-test.js",
    "core:voice-test": "node --env-file=.env core/voice/smoke-test.js",
    "core:test-build": "node --env-file=.env core/test-build-check.js",
    "core:diagnose": "node --env-file=.env core/diagnostics.js",
    "core:self-update": "node --env-file=.env core/self-upgrade.js",
    "start": "node scripts/start-unified.mjs && npm run interface:build && node --env-file=.env core/server.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "fish-audio": "^1.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "motion": "^12.23.24",
    "prismjs": "^1.30.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.8.2"
  },
  "engines": { "node": ">=20" }
}
