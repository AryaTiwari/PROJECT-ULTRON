{
  "name": "ultron-mark4",
  "version": "4.0.0-alpha.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "apps/ui",
    "services/gateway",
    "services/capability-host"
  ],
  "scripts": {
    "bootstrap": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap.ps1",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w apps/ui",
    "check": "npm run check:gateway && node scripts/selftest-capabilities.mjs && npm run build -w apps/ui",
    "catalog:sync": "node scripts/sync-free-model-catalog.mjs",
    "start:gateway": "node services/gateway/src/server.mjs",
    "check:gateway": "node scripts/run-gateway-tests.mjs"
  }
}
