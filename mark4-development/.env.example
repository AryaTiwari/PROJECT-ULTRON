ULTRON_M4_PORT=8787
ULTRON_M4_HERMES_URL=http://127.0.0.1:8642
ULTRON_M4_HERMES_API_KEY=
ULTRON_M4_INTERNAL_KEY=
ULTRON_M4_SESSION_KEY=ultron:arya:desktop
ULTRON_M4_HERMES_START_TIMEOUT_MS=300000

ULTRON_M4_COGNITION_PROVIDER=
ULTRON_M4_COGNITION_MODEL=
ULTRON_M4_WORKER_PROVIDER=
ULTRON_M4_WORKER_MODEL=
ULTRON_M4_VERIFIER_PROVIDER=
ULTRON_M4_VERIFIER_MODEL=
ULTRON_M4_CREATIVE_PROVIDER=
ULTRON_M4_CREATIVE_MODEL=

# Conversation credential pool, in priority order.
# GEMINI_APY_KEY is accepted intentionally for compatibility with the requested env name.
GEMINI_APY_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY2=
GROK_API_KEY=
GROK_API_KEY2=
# Existing Groq keys remain supported as a separate provider.
GROQ_API_KEY=
GROQ_API_KEY2=
NVIDIA_API_KEY=

ULTRON_M4_GEMINI_MODEL=gemini-3.7-flash
ULTRON_M4_GROK_MODEL=grok-4.6
ULTRON_M4_GROQ_MODEL=qwen/qwen3.8-27b
ULTRON_M4_NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

APOLLO_API_KEY=
ULTRON_M4_ALLOW_LEGACY=0


# OmniRoute fallback / test route.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_ENDPOINT_KEY=
OMNIROUTE_DIR=
ULTRON_OMNIROUTE_DEFAULT_MODEL=auto/best-reasoning
ULTRON_OMNIROUTE_TEST_MODEL=auto/best-fast
ULTRON_OMNIROUTE_CONTEXT_LENGTH=131072
ULTRON_M4_OMNIROUTE_TEST=0
