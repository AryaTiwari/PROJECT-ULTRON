# Project Ultron environment template
# NEVER put real secrets in this file.

# ULTRON Core
ULTRON_CORE_HOST=127.0.0.1
ULTRON_CORE_PORT=8787
ULTRON_MODEL=auto
ULTRON_MODEL_TIMEOUT_MS=120000

# OmniRoute (local model gateway)
OMNIROUTE_BASE_URL=http://127.0.0.1:20128
OMNIROUTE_CHAT_URL=http://127.0.0.1:20128/v1/chat/completions

# Gemini (optional direct provider/fallback)
GEMINI_API_KEY=

# Supabase — primary long-term memory
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional server-side Supabase key. Keep this local and NEVER commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Existing n8n integration (optional; not required by Mark 2 core)
N8N_BASE_URL=http://localhost:5678

# Future integrations
WEATHER_API_KEY=
STOCK_API_KEY=
