# Project ULTRON environment template
# NEVER put real secrets in this file. Copy needed values into .env locally.

# OmniRoute gateway
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_CHAT_URL=http://127.0.0.1:20128/v1/chat/completions
OMNIROUTE_API_KEY=
OMNIROUTE_ENDPOINT_KEY=
OMNIROUTE_MODEL_CACHE_MS=300000
ULTRON_MODEL_PROVIDER=omniroute
ULTRON_MODEL_TIMEOUT_MS=120000

# Mark 3 OmniRoute runtime
# Normal ULTRON use must run OmniRoute through its packaged production CLI, not
# scripts/dev/run-next.mjs dev. The 2 GB heap cap is intentionally conservative
# for the current 8 GB Windows laptop. Override locally only if required.
ULTRON_OMNIROUTE_PACKAGE_VERSION=3.8.51
ULTRON_OMNIROUTE_MEMORY_MB=2048
ULTRON_M3_OMNIROUTE_READY_TIMEOUT_MS=240000
ULTRON_M3_ALLOW_OMNIROUTE_SOURCE_DEV=0

# Mark 3 OmniRoute router
# Primary path: OmniRoute native aliases (auto/best-fast, auto/best-reasoning,
# auto/best-coding), matching the transport architecture that worked in Mark 2.
# Managed concrete-provider routing is only a fallback.
ULTRON_M3_ROUTER_MAX_CANDIDATES=6
ULTRON_M3_CANDIDATE_TIMEOUT_MS=12000
ULTRON_M3_HEAVY_CANDIDATE_TIMEOUT_MS=22000
ULTRON_M3_NATIVE_ROUTE_TIMEOUT_MS=30000
ULTRON_M3_NATIVE_HEAVY_ROUTE_TIMEOUT_MS=45000
ULTRON_M3_CONFIGURED_MODELS_PER_PROVIDER=3
ULTRON_M3_UNCONFIGURED_MODELS_PER_PROVIDER=1
ULTRON_M3_PROVIDER_HEALTH_TTL_MS=1800000
ULTRON_M3_REQUIRE_READY_PROVIDER=1

# Concrete fallback policy. Browser/CLI routes stay out of managed fallback unless
# explicitly enabled. A gateway-wide resource_pressure error never triggers model
# fan-out because every provider request would hit the same admission guard.
ULTRON_M3_ALLOW_EXPERIMENTAL_PROVIDERS=0
ULTRON_M3_ALLOW_UNKNOWN_PROVIDERS=0
ULTRON_M3_PROVIDER_ALLOWLIST=
ULTRON_M3_PROVIDER_DENYLIST=

# Optional task-specific concrete fallback overrides. Leave blank to let OmniRoute
# native auto routing choose the route first.
ULTRON_OMNIROUTE_MODEL_CODING=
ULTRON_OMNIROUTE_MODEL_RESEARCH=
ULTRON_OMNIROUTE_MODEL_AUTOMATION=
ULTRON_OMNIROUTE_MODEL_PLANNING=
ULTRON_OMNIROUTE_MODEL_CREATIVE=
ULTRON_OMNIROUTE_MODEL_SIMPLE_QA=
ULTRON_OMNIROUTE_MODEL_GENERAL=

# Optional API-backed providers for the managed fallback layer. These are not
# required if OmniRoute already has working provider state of its own.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
QWEN_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
VERTEX_API_KEY=
ZENMUX_API_KEY=
BYTEZ_API_KEY=
POLLINATIONS_API_KEY=

# Mark 3 server
ULTRON_M3_HOST=127.0.0.1
ULTRON_M3_PORT=8790
ULTRON_M3_PROACTIVE_INTERVAL_MS=120000
ULTRON_M3_MAX_CONTEXT_ITEMS=18
ULTRON_M3_MAX_CONVERSATION_ITEMS=40

# Voice / TTS — existing cloned Fish voice first, Windows SAPI fallback in Mark 3
FISH_API_KEY=
ULTRON_FISH_MODEL=s2.1-pro-free
ULTRON_VOICE_ROOT=.ultron/voice
ULTRON_VOICE_REFERENCE_PATH=.ultron/voice/ultron-reference.mp3
ULTRON_VOICE_CLONE_STATE=.ultron/voice/voice-clone.json
ULTRON_TTS_OUTPUT_DIR=.ultron/audio
ULTRON_TTS_FORMAT=mp3
ULTRON_M3_VOICE_FALLBACK=windows-sapi
ULTRON_VOICE_STYLE=subtle-metallic-cinematic
ULTRON_METALLIC_MIX=0.18
ULTRON_VOICE_QUALITY=25

# GitHub integration
GITHUB_TOKEN=
ULTRON_GITHUB_OWNER=AryaTiwari
ULTRON_GITHUB_REPO=PROJECT-ULTRON
ULTRON_GITHUB_BRANCH=mark3-development

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# n8n (future deterministic automation integrations)
N8N_BASE_URL=http://localhost:5678

# Optional external services
WEATHER_API_KEY=
STOCK_API_KEY=
