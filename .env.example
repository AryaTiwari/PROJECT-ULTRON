# Project Ultron Mark 2 environment template
# NEVER put real secrets in this file.

# OmniRoute / model gateway
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_CHAT_URL=http://127.0.0.1:20128/v1/chat/completions
OMNIROUTE_API_KEY=
ULTRON_MODEL=auto
ULTRON_MODEL_PROVIDER=omniroute
ULTRON_OMNIROUTE_DEFAULT_MODEL=
ULTRON_OMNIROUTE_MODEL_CODING=
ULTRON_OMNIROUTE_MODEL_RESEARCH=
ULTRON_OMNIROUTE_MODEL_AUTOMATION=
ULTRON_OMNIROUTE_MODEL_PLANNING=
ULTRON_OMNIROUTE_MODEL_CREATIVE=
ULTRON_OMNIROUTE_MODEL_SIMPLE_QA=
ULTRON_OMNIROUTE_MODEL_GENERAL=
ULTRON_MODEL_CODING=
ULTRON_MODEL_RESEARCH=
ULTRON_MODEL_AUTOMATION=
ULTRON_MODEL_PLANNING=
ULTRON_MODEL_CREATIVE=
ULTRON_MODEL_SIMPLE_QA=
ULTRON_MODEL_GENERAL=
ULTRON_LEARNED_ROUTING_MIN_SAMPLES=5
OMNIROUTE_MODEL_CACHE_MS=300000
ULTRON_MODEL_TIMEOUT_MS=120000

# ULTRON Core
ULTRON_NAME=ULTRON
ULTRON_CORE_HOST=127.0.0.1
ULTRON_CORE_PORT=8787
ULTRON_RECENT_MESSAGE_LIMIT=12
ULTRON_MEMORY_SIMILARITY_THRESHOLD=0.82
ULTRON_MEMORY_NEAR_DUPLICATE_THRESHOLD=0.72
ULTRON_SELF_MAINTENANCE_ENABLED=false
ULTRON_SELF_UPGRADE_ENABLED=false
ULTRON_SELF_UPGRADE_AUTO_APPLY=false

# Voice / TTS — local Chatterbox Turbo; no paid API required
ULTRON_VOICE_MODEL=ResembleAI/chatterbox-turbo
ULTRON_VOICE_ENGINE=chatterbox-turbo
ULTRON_VOICE_REFERENCE_PATH=.ultron/voice/ultron-reference.mp3
ULTRON_TTS_FORMAT=wav
ULTRON_TTS_OUTPUT_DIR=.ultron/audio
ULTRON_VOICE_AUTOPLAY=true
ULTRON_WAKE_WORD=ULTRON
ULTRON_STT_PROVIDER=windows-speech
ULTRON_VOICE_STYLE=subtle-metallic-cinematic
ULTRON_METALLIC_MIX=0.18
ULTRON_VOICE_PORT=8790

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# n8n (kept for future deterministic automation integrations)
N8N_BASE_URL=http://localhost:5678

# Optional provider keys for future direct adapters
GEMINI_API_KEY=
WEATHER_API_KEY=
STOCK_API_KEY=
