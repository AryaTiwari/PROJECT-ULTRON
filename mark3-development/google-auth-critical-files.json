{
  "contractVersion": "google-auth-contract-v1",
  "runtime": "mark3",
  "criticalFiles": [
    "core/google-sheets-auth.js",
    "core/google-sheets-operator.js",
    "scripts/google-sheets-auth.js",
    "scripts/google-sheets-auth-doctor.js",
