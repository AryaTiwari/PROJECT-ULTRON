# ULTRON Mark 3 configuration
ULTRON_M3_HOST=127.0.0.1
ULTRON_M3_PORT=8790

# OpenRouter inference fabric
# OpenRouter is OpenAI-compatible and replaces OmniRoute for normal LLM inference.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Set to 1 for zero-cost inference only. When 0, Mark 3 uses free models first,
# then falls back through the live OpenRouter catalog.
ULTRON_M3_FREE_ONLY=0
ULTRON_M3_MODEL_CANDIDATES=12
ULTRON_M3_OPENROUTER_STRICT=1

# Devin / agentic bridge
# Preserved as a separate execution lane; it is not part of normal OpenRouter chat routing.
ULTRON_M3_DEVIN_BRIDGE_ENABLED=1
ULTRON_M3_DEVIN_BRIDGE_MODEL=dva/swe-1-7-lightning
ULTRON_M3_DEVIN_BRIDGE_TIMEOUT_MS=180000

# GitHub
GITHUB_TOKEN=
ULTRON_GITHUB_OWNER=AryaTiwari
ULTRON_GITHUB_REPO=PROJECT-ULTRON
ULTRON_GITHUB_BRANCH=mark3-development

# Existing Mark 2 voice core (used only as TTS service during Mark 3 transition)
ULTRON_PARENT_CORE_URL=http://127.0.0.1:8787

# Optional tuning
ULTRON_M3_MAX_CONTEXT_ITEMS=18
ULTRON_M3_MAX_CONVERSATION_ITEMS=40
ULTRON_M3_PROACTIVE_INTERVAL_MS=120000
