# ULTRON Mark 3 configuration
ULTRON_M3_HOST=127.0.0.1
ULTRON_M3_PORT=8790
ULTRON_M3_TIMEZONE=Asia/Kolkata

# Direct-primary multi-key model pool
# Keep real values only in the Project-Ultron root .env file.
ULTRON_M3_DIRECT_ENABLED=1
GEMINI_API_KEY=
GEMINI_API_KEY2=
GROQ_API_KEY=
GROQ_API_KEY2=
NVIDIA_API_KEY=
GOOGLE_API_KEY=
GOOGLE_API_KEY2=
NVIDIA_API_KEY2=
NVIDIA_NIM_API_KEY=

# Provider routing / cooldowns
ULTRON_M3_DIRECT_MODEL_CACHE_MS=600000
ULTRON_M3_DIRECT_MODEL_DISCOVERY_TIMEOUT_MS=7000
ULTRON_M3_DIRECT_MODELS_PER_PROVIDER=3
ULTRON_M3_DIRECT_KEY_RATE_LIMIT_COOLDOWN_MS=90000
ULTRON_M3_DIRECT_KEY_ACCESS_COOLDOWN_MS=1800000
ULTRON_M3_DIRECT_KEY_UPSTREAM_COOLDOWN_MS=20000
ULTRON_M3_DIRECT_GEMINI_MODELS=
ULTRON_M3_DIRECT_GROQ_MODELS=
ULTRON_M3_DIRECT_NVIDIA_MODELS=
ULTRON_M3_DIRECT_PROVIDER_ORDER_GENERAL=
ULTRON_M3_DIRECT_PROVIDER_ORDER_CODING=
ULTRON_M3_DIRECT_PROVIDER_ORDER_PLANNING=
ULTRON_M3_DIRECT_PROVIDER_ORDER_RESEARCH=
ULTRON_M3_DIRECT_PROVIDER_ORDER_SIMPLE_QA=
ULTRON_M3_DIRECT_PROVIDER_ORDER_AUTOMATION=

# OmniRoute — lazy fallback only when direct routes are unavailable.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_ENDPOINT_KEY=
ULTRON_OMNIROUTE_PACKAGE_VERSION=3.8.51
ULTRON_OMNIROUTE_MEMORY_MB=2048
ULTRON_M3_OMNIROUTE_LAZY_TIMEOUT_MS=75000

# Model League is diagnostics-only unless deliberately enabled.
ULTRON_M3_LEAGUE_ENABLED=0
ULTRON_M3_LEAGUE_ARENA_ENABLED=0
ULTRON_M3_LEAGUE_PARTICIPANTS=4
ULTRON_M3_LEAGUE_BACKUPS=3

# Devin / agentic bridge
ULTRON_M3_DEVIN_BRIDGE_ENABLED=1
ULTRON_M3_DEVIN_BRIDGE_MODEL=dva/swe-1-7-lightning
ULTRON_M3_DEVIN_BRIDGE_TIMEOUT_MS=180000

# GitHub
GITHUB_TOKEN=
ULTRON_GITHUB_OWNER=AryaTiwari
ULTRON_GITHUB_REPO=PROJECT-ULTRON
ULTRON_GITHUB_BRANCH=mark3-development

# Reel Factory — enrolled stock/video sources
PEXELS_API_KEY=
PIXABAY_API_KEY=
FISH_API_KEY=

# Cloudflare Workers AI — optional Reel visual fallback.
# Keep disabled until CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN are configured.
# FLUX.1 schnell is used only when stock search returns no usable clip; generated stills are animated locally with FFmpeg.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
ULTRON_M3_CF_AI_IMAGE_ENABLED=0
ULTRON_M3_CF_AI_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
ULTRON_M3_CF_AI_DAILY_MAX=4
ULTRON_M3_CF_AI_STEPS=4
ULTRON_M3_CF_AI_TIMEOUT_MS=90000

# Instagram professional account — enrolled
INSTAGRAM_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Current Graph API pin for DM/conversation operations.
ULTRON_M3_INSTAGRAM_API_VERSION=v26.0
ULTRON_M3_INSTAGRAM_DM_TIMEOUT_MS=20000
# Meta app permission required for inbox reads and replies: instagram_business_manage_messages
# Official Instagram Messaging cannot initiate cold DMs; first outreach remains manual.

# India-first creator research / Elevate outreach
ULTRON_M3_CREATOR_MARKET=India
ULTRON_M3_CREATOR_DEFAULT_LIMIT=20
ULTRON_M3_CREATOR_CITIES=Mumbai,Delhi,Bengaluru,Kolkata,Hyderabad,Chennai,Pune,Ahmedabad,Jaipur,Surat,Chandigarh,Lucknow,Indore,Kochi

# Research fabric — enrolled
TINYFISH_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Lead Workspace v3 source fusion.
# SerpApi is used for Google Jobs signals and as a people-search fallback.
SERP_API_KEY=
ULTRON_M3_SERP_JOBS_MAX_RESULTS=18
# Apify is used selectively for local-business / Google Maps missions only.
APIFY_API_KEY=
APIFY_GOOGLE_MAPS_ACTOR=compass~crawler-google-places
ULTRON_M3_APIFY_MAPS_MAX_PLACES=12

# LinkedIn Public Research uses SerpApi's public Google index. It never signs into LinkedIn,
# stores LinkedIn session cookies, or bypasses auth/anti-bot controls.
ULTRON_M3_LINKEDIN_MAX_SEARCH_CALLS=10
ULTRON_M3_LINKEDIN_MAX_RESULTS=120
# Optional best-effort fetch of a LinkedIn page only when it is already publicly readable.
# Keep off for the most stable/no-login behavior.
ULTRON_M3_LINKEDIN_DIRECT_PUBLIC_FETCH=0

# Dedicated authenticated LinkedIn Account Research.
# Primary runtime: stickerdaniel/linkedin-mcp-server, bound to loopback only.
# Authentication is created explicitly with npm run linkedin:setup. Passwords are never stored here.
ULTRON_M3_LINKEDIN_MCP_PACKAGE=mcp-server-linkedin@4.24.2
# Local LinkedIn MCP now uses official stdio transport; no localhost MCP port is required.
ULTRON_M3_LINKEDIN_MCP_START_TIMEOUT_MS=90000
ULTRON_M3_LINKEDIN_MCP_TOOL_TIMEOUT_MS=300000
ULTRON_M3_LINKEDIN_BROWSER_WAIT_SECONDS=45
ULTRON_M3_LINKEDIN_BROWSER_IDLE_SECONDS=600
ULTRON_M3_LINKEDIN_PAGE_TIMEOUT_MS=10000
UV_HTTP_TIMEOUT=300
# Account-safety envelope. ULTRON stops rather than bypassing checkpoints/rate limits.
# Temporary testing only: bypasses ULTRON's local burst/hourly/daily counters.
# It does NOT bypass real LinkedIn 429 cooldowns, checkpoints, auth locks or write-action blocks.
ULTRON_M3_LINKEDIN_TEST_BYPASS_LOCAL_BUDGET=0
ULTRON_M3_LINKEDIN_TEST_MISSION_TOOL_MAX=120
ULTRON_M3_LINKEDIN_TEST_JOB_SEARCH_MAX=20
ULTRON_M3_LINKEDIN_SPEED_PROFILE=fast-safe
ULTRON_M3_LINKEDIN_MIN_GAP_MS=5000
ULTRON_M3_LINKEDIN_JITTER_MS=500
ULTRON_M3_LINKEDIN_BURST_MAX=12
ULTRON_M3_LINKEDIN_BURST_WINDOW_MS=300000
ULTRON_M3_LINKEDIN_HOURLY_MAX=30
ULTRON_M3_LINKEDIN_DAILY_MAX=100
ULTRON_M3_LINKEDIN_MISSION_TOOL_MAX=16
# Fast-safe profile: first confirmed 429 cooldown is 10 minutes; repeated throttles within 24 hours still escalate automatically.
ULTRON_M3_LINKEDIN_RATE_LIMIT_COOLDOWN_MS=600000
ULTRON_M3_LINKEDIN_ERROR_BACKOFF_MS=300000
ULTRON_M3_LINKEDIN_DEEP_PROFILE_MAX=10
ULTRON_M3_LINKEDIN_JOB_MAX_PAGES=3
ULTRON_M3_LINKEDIN_JOB_DETAIL_MAX=4

# Apollo decision-maker selection + contact enrichment.
# The key must allow mixed_people_api_search and people_match (or be a Master API key).
APOLLO_API_KEY=
APOLLO_WEBHOOK_URL=
APOLLO_WEBHOOK_SECRET=
ULTRON_M3_APOLLO_PEOPLE_SEARCH_DELAY_MS=900
ULTRON_M3_APOLLO_COMPANY_SEARCH_MAX=50
# Results-first final-POC contact deepening.
# Phone waterfall runs only after exact identity+employer verification; never on discovery pools.
ULTRON_M3_THREE_POC_PHONE_WATERFALL=1
ULTRON_M3_THREE_POC_PHONE_WATERFALL_MAX=20
ULTRON_M3_THREE_POC_PHONE_WATERFALL_COOLDOWN_DAYS=7
ULTRON_M3_THREE_POC_PHONE_WATERFALL_POLLS=3
ULTRON_M3_THREE_POC_PHONE_WATERFALL_MAX_WAIT_MS=1800
# Business-email waterfall remains final-verified-POC only.
ULTRON_M3_THREE_POC_EMAIL_WATERFALL_MAX=30
ULTRON_M3_THREE_POC_EMAIL_WATERFALL_COOLDOWN_DAYS=14
ULTRON_M3_THREE_POC_EMAIL_WATERFALL_POLLS=2
ULTRON_M3_THREE_POC_EMAIL_WATERFALL_MAX_WAIT_MS=2500
# Mandatory empty POC-2 may try up to five verified people before AI.
ULTRON_M3_UNIVERSAL_POC2_HYDRATION_ATTEMPTS=5
# Optional joeyism/linkedin_scraper fallback for exact person/company URLs.
# Disabled by default because it is a heavier Playwright runtime and its repository
# currently has inconsistent package-vs-root license metadata, so ULTRON never vendors its source.
ULTRON_M3_LINKEDIN_JOEYISM_ENABLED=0
ULTRON_M3_LINKEDIN_JOEYISM_SESSION=.ultron/credentials/linkedin-joeyism-session.json
ULTRON_M3_LINKEDIN_JOEYISM_TIMEOUT_MS=120000

# Live source doctor keeps job/Maps calls off unless explicitly enabled.
ULTRON_M3_LEAD_SOURCE_LIVE_JOBS=0
ULTRON_M3_LEAD_SOURCE_LIVE_MAPS=0

# Buffer — enrolled for channel verification and safe post dry-runs.
# Live publication remains approval-gated.
BUFFER_API_KEY=

# Telegram Remote — code retained, enrollment intentionally paused.
# Keep disabled until the founder explicitly chooses to pair it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
ULTRON_M3_TELEGRAM_ENABLED=0

# Microsoft OneDrive / Excel workbook adapter.
# Uses delegated Microsoft Graph Files.ReadWrite through authorization-code + PKCE localhost login.
# The client ID is not a secret. No client secret is used.
MICROSOFT_GRAPH_CLIENT_ID=
ULTRON_M3_MICROSOFT_TENANT=common
MICROSOFT_GRAPH_TOKEN_PATH=.ultron/credentials/microsoft-graph-token.json
ULTRON_M3_MICROSOFT_XLSX_MAX_BYTES=20971520

# Continuity / conversation
ULTRON_M3_SESSION_GAP_MS=2700000
ULTRON_M3_MAX_CONTEXT_ITEMS=18
ULTRON_M3_MAX_CONVERSATION_ITEMS=40
ULTRON_M3_PROACTIVE_INTERVAL_MS=120000


# Personalized Email Outreach Operator
# Keep real credentials only in the Project-Ultron root .env.
# Preparing and previewing never sends. Delivery requires explicit campaign approval.
ULTRON_M3_EMAIL_SMTP_HOST=
ULTRON_M3_EMAIL_SMTP_PORT=587
ULTRON_M3_EMAIL_SMTP_SECURE=0
ULTRON_M3_EMAIL_SMTP_USER=
ULTRON_M3_EMAIL_SMTP_PASSWORD=
ULTRON_M3_EMAIL_FROM=
ULTRON_M3_EMAIL_FROM_NAME=Elevate OS
ULTRON_M3_EMAIL_REPLY_TO=
ULTRON_M3_EMAIL_SIGNATURE=

# Optional IMAP configuration enables reply-aware follow-up rules.
ULTRON_M3_EMAIL_IMAP_HOST=
ULTRON_M3_EMAIL_IMAP_PORT=993
ULTRON_M3_EMAIL_IMAP_SECURE=1
ULTRON_M3_EMAIL_IMAP_USER=
ULTRON_M3_EMAIL_IMAP_PASSWORD=

# Email safety envelope.
ULTRON_M3_EMAIL_CAMPAIGN_MAX=50
ULTRON_M3_EMAIL_DAILY_MAX=40
ULTRON_M3_EMAIL_MIN_GAP_MS=15000
ULTRON_M3_EMAIL_MAX_CONSECUTIVE_FAILURES=3
ULTRON_M3_EMAIL_SCHEDULER_ENABLED=1
ULTRON_M3_EMAIL_SCHEDULER_INTERVAL_MS=60000
ULTRON_M3_EMAIL_ATTACHMENT_MAX_BYTES=10485760
ULTRON_M3_EMAIL_ATTACHMENTS_TOTAL_MAX_BYTES=20971520
