# ULTRON Mark 3 configuration
ULTRON_M3_HOST=127.0.0.1
ULTRON_M3_PORT=8790

# OmniRoute
# Create this key in OmniRoute Dashboard -> API Manager / Endpoints.
# This is the key used to authenticate Mark 3 against http://127.0.0.1:20128/v1
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_ENDPOINT_KEY=

# Devin / agentic bridge
# Keep this enabled to expose bridge models such as dva/swe-1-7-lightning.
# The bridge is used for coding/automation tasks; ordinary chat stays on direct models.
ULTRON_M3_DEVIN_BRIDGE_ENABLED=1
ULTRON_M3_DEVIN_BRIDGE_MODEL=dva/swe-1-7-lightning
ULTRON_M3_DEVIN_BRIDGE_TIMEOUT_MS=180000

# These are consumed by the OmniRoute process itself. They must be set in the
# OmniRoute process environment, not inside the Mark 3 chat request.
DEVIN_AGENTIC_HOME=/home/bridge
DEVIN_AGENTIC_ACP_TIMEOUT_MS=180000
CLI_DEVIN_AGENTIC_BIN=devin
DEVIN_BRIDGE_MODEL=devin-cli-agentic/swe-1-7
DEVIN_BRIDGE_SONNET_MODEL=devin-cli-agentic/swe-1-7
DEVIN_BRIDGE_OPUS_MODEL=devin-cli-agentic/swe-1-7
DEVIN_BRIDGE_HAIKU_MODEL=devin-cli-agentic/swe-1-7
DEVIN_BRIDGE_SUBAGENT_MODEL=devin-cli-agentic/swe-1-7

# GitHub
GITHUB_TOKEN=
ULTRON_GITHUB_OWNER=AryaTiwari
ULTRON_GITHUB_REPO=PROJECT-ULTRON
ULTRON_GITHUB_BRANCH=mark3-development

# Existing Mark 2 voice core (used only as TTS service during Mark 3 transition)
ULTRON_PARENT_CORE_URL=http://127.0.0.1:8787

# Optional tuning
ULTRON_M3_MAX_CONTEXT_ITEMS=18
ULTRON_M3_MAX_CONVERSATION_ITEMS=40
ULTRON_M3_PROACTIVE_INTERVAL_MS=120000
