# ULTRON Mark 3 configuration
ULTRON_M3_HOST=127.0.0.1
ULTRON_M3_PORT=8790

# Direct-primary multi-key model pool
# Keep real values only in the Project-Ultron root .env file.
# KEY and KEY2 may come from separate accounts. Mark 3 balances requests and
# cools down an exhausted key without disabling the other key for that provider.
ULTRON_M3_DIRECT_ENABLED=1
GEMINI_API_KEY=
GEMINI_API_KEY2=
GROQ_API_KEY=
GROQ_API_KEY2=
NVIDIA_API_KEY=
# Optional aliases/extra slots
GOOGLE_API_KEY=
GOOGLE_API_KEY2=
NVIDIA_API_KEY2=
NVIDIA_NIM_API_KEY=

# Default provider specialties
# simple Q&A / automation: Groq -> Gemini -> NVIDIA
# general conversation:    Gemini -> Groq -> NVIDIA
# coding / planning:       NVIDIA -> Gemini -> Groq
# research:                Gemini -> NVIDIA -> Groq
# Mark 3 discovers each provider's live model catalog and ranks models by task.
ULTRON_M3_DIRECT_MODEL_CACHE_MS=600000
ULTRON_M3_DIRECT_MODEL_DISCOVERY_TIMEOUT_MS=7000
ULTRON_M3_DIRECT_MODELS_PER_PROVIDER=3
ULTRON_M3_DIRECT_KEY_RATE_LIMIT_COOLDOWN_MS=90000
ULTRON_M3_DIRECT_KEY_ACCESS_COOLDOWN_MS=1800000
ULTRON_M3_DIRECT_KEY_UPSTREAM_COOLDOWN_MS=20000

# Optional model/provider overrides
ULTRON_M3_DIRECT_GEMINI_MODELS=
ULTRON_M3_DIRECT_GROQ_MODELS=
ULTRON_M3_DIRECT_NVIDIA_MODELS=
ULTRON_M3_DIRECT_PROVIDER_ORDER_GENERAL=
ULTRON_M3_DIRECT_PROVIDER_ORDER_CODING=
ULTRON_M3_DIRECT_PROVIDER_ORDER_PLANNING=
ULTRON_M3_DIRECT_PROVIDER_ORDER_RESEARCH=
ULTRON_M3_DIRECT_PROVIDER_ORDER_SIMPLE_QA=
ULTRON_M3_DIRECT_PROVIDER_ORDER_AUTOMATION=

# OmniRoute — SECONDARY lazy fallback only when direct routes are unavailable.
# Create this key in OmniRoute Dashboard -> API Manager / Endpoints.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_ENDPOINT_KEY=
ULTRON_OMNIROUTE_PACKAGE_VERSION=3.8.51
ULTRON_OMNIROUTE_MEMORY_MB=2048
ULTRON_M3_OMNIROUTE_LAZY_TIMEOUT_MS=75000

# Model League learns among direct models whenever a direct credential is present.
# That keeps background tournaments from waking OmniRoute.
ULTRON_M3_LEAGUE_ENABLED=1
ULTRON_M3_LEAGUE_PARTICIPANTS=4
ULTRON_M3_LEAGUE_BACKUPS=3

# Devin / agentic bridge
ULTRON_M3_DEVIN_BRIDGE_ENABLED=1
ULTRON_M3_DEVIN_BRIDGE_MODEL=dva/swe-1-7-lightning
ULTRON_M3_DEVIN_BRIDGE_TIMEOUT_MS=180000

# GitHub
GITHUB_TOKEN=
ULTRON_GITHUB_OWNER=AryaTiwari
ULTRON_GITHUB_REPO=PROJECT-ULTRON
ULTRON_GITHUB_BRANCH=mark3-development

# Optional tuning
ULTRON_M3_MAX_CONTEXT_ITEMS=18
ULTRON_M3_MAX_CONVERSATION_ITEMS=40
ULTRON_M3_PROACTIVE_INTERVAL_MS=120000
